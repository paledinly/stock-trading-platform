# 장중 연구·가상매매: Closing 전략과 별도 설정입니다.
# 기존 .env에 이 항목들을 추가하고 값을 설정한 뒤 Backend를 재시작하세요.
# 비용 6개는 모두 % 단위입니다. 예: 0.01 = 0.01% (1%가 아님).
# 비용이 비어 있어도 가격 기준으로 추천합니다. 6개 모두 설정해야 비용 포함 R:R·Net을 계산합니다.
# 일부만 설정한 경우에도 비용 전체를 미반영으로 표시합니다. 0은 명시적인 무비용 가정입니다.

# true: 장중 입력 저장·후보 평가·가상매매 실행 / false: 장중 신규 수집·평가 중지.
# 실제 주문은 실행하지 않습니다. MARKET_REALTIME_ENABLED=true와 실시간 구독 종목이 필요합니다.
# 활성화 후 종목별 연속 30분 관측이 필요하며, 조건 충족 시에만 추천합니다.
INTRADAY_ENABLED=false

# 매수 수수료율(%): 매수 가상 체결금액에 추가하여 총 매수 비용을 계산합니다.
INTRADAY_BUY_FEE_PERCENT=

# 매도 수수료율(%): 매도 가상 체결금액에서 차감하여 순 매도 수령액을 계산합니다.
INTRADAY_SELL_FEE_PERCENT=

# 매도 관련 세금률(%): 매도 가상 체결금액에서 수수료와 별도로 차감합니다.
# 매수에는 적용하지 않으며, 현행 세율을 코드에서 자동으로 결정하지 않습니다.
INTRADAY_SELL_TAX_PERCENT=

# 전체 매수·매도 호가 간격에 대한 비용 가정(%): 절반씩 양쪽 체결가격에 적용합니다.
# 예: 0.10이면 매수 기준가격에 +0.05%, 매도 기준가격에 -0.05%를 적용합니다.
# 실측 호가값이 아닌 모델 가정이며, 아래 Slippage와 합산하므로 중복 산정하지 마세요.
INTRADAY_SPREAD_PERCENT=

# 매수 Slippage(%): Spread 외에 기준가격보다 더 비싸게 체결되는 정도를 가정합니다.
# 매수 가상 체결가 = 기준가격 × [1 + (Spread/2 + 매수 Slippage)/100].
INTRADAY_BUY_SLIPPAGE_PERCENT=

# 매도 Slippage(%): Spread 외에 기준가격보다 더 싸게 체결되는 정도를 가정합니다.
# 매도 가상 체결가 = 기준가격 × [1 - (Spread/2 + 매도 Slippage)/100].
INTRADAY_SELL_SLIPPAGE_PERCENT=

# Closing recommendation quality gates (Asia/Seoul)
