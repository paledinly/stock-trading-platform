# 설정 예시입니다. .env로 복사해 값을 채웁니다(.env는 커밋하지 않습니다).
# 묶음 순서와 키 위치는 .env와 같게 유지합니다. 설명: docs/DEVELOPMENT.md, docs/OPERATIONS.md, docs/FEATURES.md

# ===== 1. 데이터베이스 · Redis =====
POSTGRES_DB=stock_platform
POSTGRES_USER=stock
POSTGRES_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/stock_platform
DB_USERNAME=stock
DB_PASSWORD=change-me
# Supabase 사용 시 Session Pooler 값을 .env에만 설정합니다.
# DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<database-password>
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== 2. KIS Open API (인증 · 주소 · 호출 한도 · 종목 마스터) =====
# 인증 키는 .env에만 넣고 절대 커밋하지 않습니다.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ENABLED=true
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_WEBSOCKET_URL=ws://ops.koreainvestment.com:21000
KIS_REQUEST_MIN_INTERVAL=125ms
KIS_QUOTE_MIN_INTERVAL=250ms
KIS_RATE_LIMIT_BACKOFF=500ms
KIS_RATE_LIMIT_MAX_RETRIES=1
KIS_QUOTE_RATE_LIMIT=4
KIS_MINUTE_RATE_LIMIT=5
KIS_RANKING_RATE_LIMIT=5
KIS_DAILY_RATE_LIMIT=5
KIS_WEBSOCKET_SUBSCRIPTION_LIMIT=41
KIS_MASTER_SYNC_ENABLED=false
KIS_MASTER_SYNC_ON_STARTUP=true
KIS_MASTER_SYNC_CRON=0 30 6 * * MON-FRI

# ===== 3. 실시간 수집 (WebSocket · 5분봉 · SSE) =====
MARKET_REALTIME_ENABLED=false
MARKET_REALTIME_STALE_TIMEOUT=60s
MARKET_REALTIME_HEALTH_CHECK_INTERVAL=30s
MARKET_REALTIME_PROCESSING_QUEUE_CAPACITY=20000
MARKET_CANDLE_WATERMARK=2s
MARKET_QUOTE_TTL=16h
MARKET_SSE_REPLAY_SIZE=1000

# ===== 4. 시장 전체 스캔 (순위 수집 · 상세 시세 · 보강 큐 · 일정) =====
MARKET_WIDE_SCHEDULE_ENABLED=false
MARKET_WIDE_OPEN=09:00
MARKET_WIDE_CLOSE=15:20
MARKET_WIDE_LATE_START=14:00
MARKET_WIDE_NORMAL_INTERVAL=5m
MARKET_WIDE_LATE_INTERVAL=2m
MARKET_WIDE_POLL_INTERVAL=30s
MARKET_WIDE_SCAN_LIMIT=120
MARKET_WIDE_CANDIDATE_LIMIT=41
MARKET_WIDE_INCLUDE_ETF=false
MARKET_WIDE_RANKING_LIMIT=100
MARKET_WIDE_DETAIL_QUOTE_BUDGET=45
MARKET_WIDE_QUOTE_CACHE_MAX_AGE=60s
MARKET_WIDE_TICK_MAX_AGE=30s
MARKET_WIDE_EXCLUDE_STRUCTURED_NAMES=true
MARKET_WIDE_ENRICHMENT_ENABLED=true
MARKET_WIDE_ENRICHMENT_CAPACITY=200
MARKET_WIDE_ENRICHMENT_MAX_ATTEMPTS=3
MARKET_WIDE_ENRICHMENT_MAX_AGE=3m
MARKET_WIDE_ENRICHMENT_RETRY_DELAY=10s
MARKET_WIDE_ENRICHMENT_POLL_INTERVAL=1s

# ===== 5. 정밀 구독 · 관심종목 실시간 고정 =====
# 정밀 구독 = 41 - (관심종목 고정 + 수동 + 다음날 관측). 14:50에 교체를 멈춥니다.
MARKET_PRECISION_ENABLED=false
MARKET_PRECISION_MAX=41
MARKET_SUBSCRIPTION_RESERVE=0
MARKET_PRECISION_MIN_HOLD=15m
MARKET_PRECISION_REPLACE_MARGIN=10
MARKET_PRECISION_FREEZE_AT=14:50
WATCHLIST_REALTIME_MAX_PINNED=10

# ===== 6. 거래일 달력 =====
MARKET_WIDE_HOLIDAYS=
# KIS 국내휴장일조회(chk-holiday)로 개장일을 하루 한 번 받아 저장하고 우선 적용합니다. 실전 계정 키가 필요합니다.
# 실패하거나 받지 못한 날짜는 위 정적 휴장일 목록(MARKET_WIDE_HOLIDAYS)을 사용합니다.
CLOSING_CALENDAR_KIS_REFRESH_ENABLED=false

# ===== 7. 마감 추천 (평가 기준 · 비용 · 자동 실행 · 다음날 관측) =====
# 시각은 모두 한국시간(Asia/Seoul)입니다.
CLOSING_EVALUATION_START=14:30
CLOSING_FEATURE_FREEZE_AT=15:15
CLOSING_ENTRY_DEADLINE=15:20
CLOSING_CANDLE_FINALIZATION_GRACE=0s
CLOSING_MIN_COVERAGE_MINUTES=20
CLOSING_MIN_FINAL_CANDLES=4
CLOSING_MIN_FINAL_SCORE=55
CLOSING_BUY_FEE_PERCENT=0
CLOSING_SELL_FEE_PERCENT=0
CLOSING_SELL_TAX_PERCENT=0
CLOSING_BUY_SLIPPAGE_PERCENT=0
CLOSING_SELL_SLIPPAGE_PERCENT=0
CLOSING_AUTOMATION_ENABLED=true
CLOSING_AUTOMATION_POLL_INTERVAL=30s
CLOSING_AUTOMATION_LIMIT=10
CLOSING_AUTOMATION_MIN_OPPORTUNITY=35
CLOSING_AUTOMATION_MAX_RISK=65
CLOSING_AUTOMATION_TARGET_RATE=3
CLOSING_AUTOMATION_STOP_RATE=-2
# 마감 공식 run의 SELECTED/WATCH 후보 중 점수 상위 N개를 남는 실시간 슬롯에 구독합니다(0=끔).
# 15:20 전 가상 진입 체결과 다음 거래일 5분봉을 확보해 후보 관측이 결측되지 않게 합니다. 공식 추천 종목이 우선이며 슬롯을 비우지 않습니다.
CLOSING_OBSERVATION_SUBSCRIPTION_LIMIT=10

# ===== 8. 일봉 준비 (08:10 후보 · 14:25/14:35 정밀 보완) =====
CLOSING_DAILY_BACKFILL_ENABLED=true
CLOSING_DAILY_BACKFILL_CRON=0 10 8 * * MON-FRI
CLOSING_DAILY_PRECISION_CRON=0 25,35 14 * * MON-FRI
CLOSING_DAILY_BACKFILL_MAX_STOCKS=40
CLOSING_DAILY_BACKFILL_LOOKBACK_DAYS=120
CLOSING_DAILY_BACKFILL_REFRESH_INTERVAL=1h

# ===== 9. 연구 수집 (점수 미사용 · 기록 전용) =====
# 판단 기간(ADR-010) 동안 점수·선정에 쓰지 않고 기록만 합니다.
# 장마감 Trajectory · 투자자 수급 · 지수(KOSPI/KOSDAQ)
CLOSING_TRAJECTORY_ENABLED=false
CLOSING_TRAJECTORY_INDEX_ENABLED=false
CLOSING_TRAJECTORY_FLOW_ENABLED=false
CLOSING_TRAJECTORY_FLOW_INTERVAL=5m
CLOSING_TRAJECTORY_FLOW_MAX_SYMBOLS=20
# 호가 · 대량체결
CLOSING_MICROSTRUCTURE_ENABLED=false
CLOSING_ORDERBOOK_ENABLED=false
CLOSING_ORDERBOOK_POLL_INTERVAL=5s
CLOSING_ORDERBOOK_MAX_SYMBOLS=2
CLOSING_ORDERBOOK_SYMBOLS=
CLOSING_LARGE_TRADE_THRESHOLD=100000000
CLOSING_MICROSTRUCTURE_MAX_GAP=15s
CLOSING_MICROSTRUCTURE_WATERMARK=2s
# 수정주가 일봉 (18:30)
MARKET_ADJUSTED_DAILY_ENABLED=false
MARKET_ADJUSTED_DAILY_CRON=0 30 18 * * MON-FRI
MARKET_ADJUSTED_DAILY_LOOKBACK_DAYS=210
MARKET_ADJUSTED_DAILY_REFRESH_DAYS=140
# 상한가 감시(15:16·15:18) · 후보 맥락(15:16:45·15:19)
CLOSING_LIMIT_UP_WATCH_ENABLED=false
CLOSING_CANDIDATE_CONTEXT_ENABLED=false
# DART 공시 목록 키(opendart.fss.or.kr). 비우면 공시 수집을 하지 않습니다.
DART_API_KEY=

# ===== 10. 기타 =====
ANALYTICS_SUMMARY_CACHE_TTL=60s
