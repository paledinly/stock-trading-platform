CLOSING_LIMIT_UP_WATCH_ENABLED=false
CLOSING_DAILY_BACKFILL_ENABLED=true
CLOSING_DAILY_BACKFILL_MAX_STOCKS=40
CLOSING_DAILY_BACKFILL_LOOKBACK_DAYS=120
CLOSING_DAILY_BACKFILL_REFRESH_INTERVAL=1h
CLOSING_DAILY_BACKFILL_CRON=0 10 8 * * MON-FRI
CLOSING_DAILY_PRECISION_CRON=0 25,35 14 * * MON-FRI
WATCHLIST_REALTIME_MAX_PINNED=10
CLOSING_TRAJECTORY_ENABLED=false
CLOSING_TRAJECTORY_FLOW_ENABLED=false
CLOSING_TRAJECTORY_FLOW_INTERVAL=5m
CLOSING_TRAJECTORY_FLOW_MAX_SYMBOLS=20
